{

  "manifest_version": 2,
  "name": "Proxy Failover",
  "version": "1.0.2",

  "description": "Direct Failover for system requests.",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "proxy-failover@mozilla.com"
    }
  },

  "applications": {
    "gecko": {
      "id": "proxy-failover@mozilla.com"
    }
  },

  "permissions": [
    "unlimitedStorage",
    "clipboardRead",
    "storage"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main.js"]
    }
  ]

}